# Build-time env vars picked up by Vite (variables prefixed VITE_* are
# inlined into the widget bundle and become readable as import.meta.env.*).
# This file is committed: the values end up in the public widget.js
# anyway, so there's no benefit to hiding them.

# First-party tracker endpoint. Empty string disables baked-in tracking;
# the widget will then only fire events if the host page sets
# window.HPW_TRACKER_ENDPOINT before the widget loads.
VITE_TRACKER_ENDPOINT=https://hotel-widget-admin-152048178748.europe-west1.run.app/api/track
